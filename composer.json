{
    "name": "sylius/sylius-mate-extension",
    "description": "Dev-only Symfony AI Mate extension for Sylius: exposes the runtime domain (resources, hooks, grids, routes, services) to AI clients via MCP.",
    "license": "MIT",
    "type": "symfony-ai-mate",
    "keywords": ["sylius", "mcp", "devtools", "ai", "dev"],
    "require": {
        "php": ">=8.2",
        "symfony/ai-mate": "^0.9",
        "mcp/sdk": "^0.5"
    },
    "require-dev": {
        "helgesverre/toon": "^3.1",
        "phpunit/phpunit": "^11.5",
        "sylius/sylius": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Sylius\\MateExtension\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sylius\\MateExtension\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "ai-mate": {
            "scan-dirs": ["src/Tool"],
            "includes": ["config/config.php"],
            "instructions": "INSTRUCTIONS.md"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

